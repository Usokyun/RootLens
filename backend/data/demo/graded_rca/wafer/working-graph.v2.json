        "feature_id": "spatial.grid",
        "value_kind": "array_ref",
        "unit": null,
        "definition": "真实晶圆网格：0背景、1正常、2失效。",
        "requires_reference": false,
        "allowed_values": null,
        "semantic_role": "context"
      }
    ],
