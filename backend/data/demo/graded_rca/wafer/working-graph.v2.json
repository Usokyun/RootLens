    "feature_registry": [
      {
        "feature_id": "detection.anomaly_present",
        "value_kind": "boolean",
        "unit": null,
        "definition": "当前范围的显式异常布尔量，不含原因信息。图像为检测器实际输出；过程为匹配正常参考的PCA残差能量门控；晶圆为非空有效网格中存在失效die。",
        "requires_reference": false,
        "allowed_values": null,
        "semantic_role": "presence_gate"
      },
      {
        "feature_id": "spatial.failure_density",
        "value_kind": "number",
        "unit": "1",
        "definition": "指定区域失效die数／有效die数；区域为空时缺失。",
        "requires_reference": false,
        "allowed_values": null,
        "semantic_role": "diagnostic"
      },
      {
        "feature_id": "spatial.valid_die_count",
        "value_kind": "number",
        "unit": "1",
        "definition": "编码为1或2的有效die数。",
        "requires_reference": false,
        "allowed_values": null,
        "semantic_role": "context"
      },
      {
        "feature_id": "spatial.failed_die_count",
        "value_kind": "number",
        "unit": "1",
        "definition": "编码为2的失效die数。",
        "requires_reference": false,
        "allowed_values": null,
        "semantic_role": "diagnostic"
      },
      {
        "feature_id": "spatial.component_count",
        "value_kind": "number",
        "unit": "1",
        "definition": "失效die的八邻域连通分量数。",
        "requires_reference": false,
        "allowed_values": null,
        "semantic_role": "diagnostic"
      },
      {
        "feature_id": "spatial.largest_component_ratio",
        "value_kind": "number",
        "unit": "1",
        "definition": "最大八邻域连通分量大小／失效die数；无失效时缺失。",
        "requires_reference": false,
        "allowed_values": null,
        "semantic_role": "diagnostic"
      },
      {
        "feature_id": "spatial.linearity",
        "value_kind": "number",
        "unit": "1",
        "definition": "1-坐标协方差最小／最大特征值；失效die少于3时缺失。",
        "requires_reference": false,
        "allowed_values": null,
        "semantic_role": "diagnostic"
      },
      {
        "feature_id": "spatial.edge_sector_participation",
        "value_kind": "number",
        "unit": "1",
        "definition": "边缘有效die的扇区参与度：以12个30°扇区、每扇区至少5个有效die、至少8个可用扇区且总失效密度非零为前提；各扇区失效密度归一为p，计算1/(k·Σp²)。越高表示失效分布于越多扇区，不是失效比例或概率。",
        "requires_reference": false,
        "allowed_values": null,
        "semantic_role": "diagnostic"
      },
      {
        "feature_id": "classifier.pattern",
        "value_kind": "category",
        "unit": null,
        "definition": "独立ResNet模型的八类图案输出，不读取数据集原生标签。",
        "requires_reference": false,
        "allowed_values": [
          "center",
          "donut",
          "edge_loc",
          "edge_ring",
          "loc",
          "random",
          "scratch",
          "nearfull"
        ],
        "semantic_role": "diagnostic"
      },
