    "source_assertions": [
      {
        "assertion_id": "source:signature:0",
        "origin": "llm_proposed",
        "text": "Step and drift disturbances in the original process description produce sustained shifts in continuous measurements such as reactor temperature and pressure.",
        "parameter_origin": "source_explicit",
        "source_id": "tep-original-process",
        "source_unit_id": "su_42dc14b197b86d03",
        "locator": "{\"char_end\": 7973, \"char_start\": 0, \"end_line\": 221, \"start_line\": 1, \"type\": \"text\"}"
      },
      {
        "assertion_id": "source:condition:0:0",
        "origin": "source_explicit",
        "text": "Reactor temperature (XMEAS(9)) is a continuous process measurement whose window mean can be displaced under a step disturbance.",
        "parameter_origin": "declared_demo_heuristic",
        "source_id": "tep-original-process",
        "source_unit_id": "su_42dc14b197b86d03",
        "locator": "{\"char_end\": 7973, \"char_start\": 0, \"end_line\": 221, \"start_line\": 1, \"type\": \"text\"}"
      },
      {
        "assertion_id": "source:condition:0:1",
        "origin": "declared_demo_heuristic",
        "text": "Residual energy is compared against the matched normal-data 99th-percentile limit; the limit is a declared heuristic here.",
        "parameter_origin": "declared_demo_heuristic",
        "source_id": "tep-original-process",
        "source_unit_id": "su_42dc14b197b86d03",
        "locator": "{\"char_end\": 7973, \"char_start\": 0, \"end_line\": 221, \"start_line\": 1, \"type\": \"text\"}"
      },
      {
        "assertion_id": "source:cause:0:0",
        "origin": "source_explicit",
        "text": "IDV(1) A/C feed ratio step and IDV(2) B composition step alter stream 4 feed composition.",
        "parameter_origin": "source_explicit",
        "source_id": "tep-original-process",
        "source_unit_id": "su_42dc14b197b86d03",
        "locator": "{\"char_end\": 7973, \"char_start\": 0, \"end_line\": 221, \"start_line\": 1, \"type\": \"text\"}"
      },
      {
        "assertion_id": "source:cause:0:1",
        "origin": "source_explicit",
        "text": "IDV(3) D feed temperature step and IDV(10) C feed temperature random variation change feed thermal boundary conditions.",
        "parameter_origin": "source_explicit",
        "source_id": "tep-original-process",
        "source_unit_id": "su_42dc14b197b86d03",
        "locator": "{\"char_end\": 7973, \"char_start\": 0, \"end_line\": 221, \"start_line\": 1, \"type\": \"text\"}"
      },
      {
        "assertion_id": "source:cause:0:2",
        "origin": "source_explicit",
        "text": "IDV(4)/IDV(11) reactor cooling water inlet temperature and IDV(5)/IDV(12) condenser cooling water inlet temperature are step/random disturbances.",
        "parameter_origin": "source_explicit",
        "source_id": "tep-original-process",
        "source_unit_id": "su_42dc14b197b86d03",
        "locator": "{\"char_end\": 7973, \"char_start\": 0, \"end_line\": 221, \"start_line\": 1, \"type\": \"text\"}"
      },
      {
        "assertion_id": "source:cause:0:3",
        "origin": "source_explicit",
        "text": "IDV(13) is a slow drift in reaction kinetics.",
        "parameter_origin": "source_explicit",
        "source_id": "tep-original-process",
        "source_unit_id": "su_42dc14b197b86d03",
        "locator": "{\"char_end\": 7973, \"char_start\": 0, \"end_line\": 221, \"start_line\": 1, \"type\": \"text\"}"
      },
      {
        "assertion_id": "source:signature:1",
        "origin": "llm_proposed",
        "text": "Random-variation disturbances and valve sticking produce fluctuating rather than purely level-shifted measurements.",
        "parameter_origin": "source_explicit",
        "source_id": "tep-original-process",
        "source_unit_id": "su_42dc14b197b86d03",
        "locator": "{\"char_end\": 7973, \"char_start\": 0, \"end_line\": 221, \"start_line\": 1, \"type\": \"text\"}"
      },
      {
        "assertion_id": "source:condition:1:0",
        "origin": "declared_demo_heuristic",
        "text": "Reactor cooling water outlet temperature (XMEAS(21)) is a continuous measurement affected by cooling-water disturbances; the std threshold is a declared heuristic.",
        "parameter_origin": "declared_demo_heuristic",
        "source_id": "tep-original-process",
        "source_unit_id": "su_42dc14b197b86d03",
        "locator": "{\"char_end\": 7973, \"char_start\": 0, \"end_line\": 221, \"start_line\": 1, \"type\": \"text\"}"
      },
      {
        "assertion_id": "source:condition:1:1",
        "origin": "declared_demo_heuristic",
        "text": "Residual energy is compared against the matched normal-data 99th-percentile limit; the limit is a declared heuristic here.",
        "parameter_origin": "declared_demo_heuristic",
        "source_id": "tep-original-process",
        "source_unit_id": "su_42dc14b197b86d03",
        "locator": "{\"char_end\": 7973, \"char_start\": 0, \"end_line\": 221, \"start_line\": 1, \"type\": \"text\"}"
      },
      {
        "assertion_id": "source:cause:1:0",
        "origin": "source_explicit",
        "text": "IDV(8) A,B,C feed composition random variation and IDV(9) D feed temperature random variation introduce fluctuating feed conditions.",
        "parameter_origin": "source_explicit",
        "source_id": "tep-original-process",
        "source_unit_id": "su_42dc14b197b86d03",
        "locator": "{\"char_end\": 7973, \"char_start\": 0, \"end_line\": 221, \"start_line\": 1, \"type\": \"text\"}"
      },
      {
        "assertion_id": "source:cause:1:1",
        "origin": "source_explicit",
        "text": "IDV(11) reactor cooling water inlet temperature and IDV(12) condenser cooling water inlet temperature are random variations.",
        "parameter_origin": "source_explicit",
        "source_id": "tep-original-process",
        "source_unit_id": "su_42dc14b197b86d03",
        "locator": "{\"char_end\": 7973, \"char_start\": 0, \"end_line\": 221, \"start_line\": 1, \"type\": \"text\"}"
      },
      {
        "assertion_id": "source:cause:1:2",
        "origin": "source_explicit",
        "text": "IDV(14) reactor cooling water valve sticking and IDV(15) condenser cooling water valve sticking are actuator faults.",
        "parameter_origin": "source_explicit",
        "source_id": "tep-original-process",
        "source_unit_id": "su_42dc14b197b86d03",
        "locator": "{\"char_end\": 7973, \"char_start\": 0, \"end_line\": 221, \"start_line\": 1, \"type\": \"text\"}"
      },
      {
        "assertion_id": "source:signature:2",
        "origin": "llm_proposed",
        "text": "Closed-loop PI controllers act on manipulated variables such as XMV(10) and XMV(11) to regulate temperatures, so an actuator shift can accompany a maintained controlled temperature.",
        "parameter_origin": "source_explicit",
        "source_id": "tep-original-control",
        "source_unit_id": "su_17d70b7d22abe2f0",
        "locator": "{\"char_end\": 29543, \"char_start\": 21568, \"end_line\": 1155, \"start_line\": 792, \"type\": \"text\"}"
      },
      {
        "assertion_id": "source:condition:2:0",
        "origin": "declared_demo_heuristic",
        "text": "XMV(10) is the reactor cooling water flow manipulated variable; the mean-z threshold is a declared heuristic.",
        "parameter_origin": "declared_demo_heuristic",
        "source_id": "tep-original-process",
        "source_unit_id": "su_42dc14b197b86d03",
        "locator": "{\"char_end\": 7973, \"char_start\": 0, \"end_line\": 221, \"start_line\": 1, \"type\": \"text\"}"
      },
      {
        "assertion_id": "source:condition:2:1",
        "origin": "declared_demo_heuristic",
        "text": "Residual energy is compared against the matched normal-data 99th-percentile limit; the limit is a declared heuristic here.",
        "parameter_origin": "declared_demo_heuristic",
        "source_id": "tep-original-process",
        "source_unit_id": "su_42dc14b197b86d03",
        "locator": "{\"char_end\": 7973, \"char_start\": 0, \"end_line\": 221, \"start_line\": 1, \"type\": \"text\"}"
      },
      {
        "assertion_id": "source:cause:2:0",
        "origin": "source_explicit",
        "text": "IDV(14) and IDV(15) are reactor and condenser cooling water valve sticking disturbances.",
        "parameter_origin": "source_explicit",
        "source_id": "tep-original-process",
        "source_unit_id": "su_42dc14b197b86d03",
        "locator": "{\"char_end\": 7973, \"char_start\": 0, \"end_line\": 221, \"start_line\": 1, \"type\": \"text\"}"
      },
      {
        "assertion_id": "source:cause:2:1",
        "origin": "source_explicit",
        "text": "Cooling water inlet temperature disturbances (IDV(4), IDV(5), IDV(11), IDV(12)) change heat-removal conditions.",
        "parameter_origin": "source_explicit",
        "source_id": "tep-original-process",
        "source_unit_id": "su_42dc14b197b86d03",
        "locator": "{\"char_end\": 7973, \"char_start\": 0, \"end_line\": 221, \"start_line\": 1, \"type\": \"text\"}"
      },
      {
        "assertion_id": "source:cause:2:2",
        "origin": "source_explicit",
        "text": "IDV(13) is a slow drift in reaction kinetics.",
        "parameter_origin": "source_explicit",
        "source_id": "tep-original-process",
        "source_unit_id": "su_42dc14b197b86d03",
        "locator": "{\"char_end\": 7973, \"char_start\": 0, \"end_line\": 221, \"start_line\": 1, \"type\": \"text\"}"
      },
      {
        "assertion_id": "source:signature:3",
        "origin": "llm_proposed",
        "text": "Feed-side disturbances and kinetics drift propagate to sampled composition analyses (XMEAS(23)-XMEAS(41)) and can dominate residual contribution.",
        "parameter_origin": "source_explicit",
        "source_id": "tep-original-process",
        "source_unit_id": "su_42dc14b197b86d03",
        "locator": "{\"char_end\": 7973, \"char_start\": 0, \"end_line\": 221, \"start_line\": 1, \"type\": \"text\"}"
      },
      {
        "assertion_id": "source:condition:3:0",
        "origin": "declared_demo_heuristic",
        "text": "XMEAS(23) is reactor feed component A mole percent from sampled analysis; the contribution threshold is a declared heuristic.",
