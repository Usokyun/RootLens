# Development defaults only. Real credentials belong in ignored .env/.env.local.
KGTRACE_POSTGRES_DSN=postgresql://kgtracevis:kgtracevis@127.0.0.1:5432/kgtracevis
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password
NEO4J_DATABASE=neo4j
# ROOTLENS_API_HOST=127.0.0.1
# ROOTLENS_API_PORT=8000

# Optional source-KG LLM (install: uv sync --extra dev --extra llm --frozen).
# Keep API credentials only in ignored backend/.env.local, never VITE_* variables.
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=your-model-id
# SOURCE_KG_LLM_API=responses
# SOURCE_KG_REASONING_EFFORT=high
# Existing DeepSeek/chat-completions setups default to chat_completions.

# Optional ROI semantics, called only when an image upload explicitly requests semantic_mode=vlm.
# KGTRACEVIS_VISION_API_KEY=        # defaults to OPENAI_API_KEY when unset
# KGTRACEVIS_VISION_BASE_URL=       # defaults to OPENAI_BASE_URL when unset
# KGTRACEVIS_VISION_MODEL=your-vision-capable-model # defaults to OPENAI_MODEL/DEEPSEEK_MODEL
# KGTRACEVIS_VISION_API=chat_completions

# Object-scoped image models for working-graph analysis; see configs/mvtec_models.example.json.
# Public normal_reference is optional and is sent only for opt-in ROI semantics.
# KGTRACEVIS_MVTEC_MODEL_MANIFEST=runs/mvtec_models.json
